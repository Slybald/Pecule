    "storage.recovery.message.backupFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The safety copy could not be created (for example, because the device is full). As a precaution, your data was not opened and is untouched. Free up some space if needed, then tap Try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie de sécurité n’a pas pu être créée (par exemple faute d’espace). Par précaution, tes données n’ont pas été ouvertes et restent intactes. Libère de l’espace si besoin, puis appuie sur Réessayer."
          }
        }
      }
    },
    "storage.recovery.message.copyKept" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app has not deleted anything. A safety copy of your data is kept on this device. Tap Try again. If the problem persists, do not delete the app: the copy would be erased with it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application n’a rien supprimé. Une copie de sécurité de tes données est conservée sur cet appareil. Appuie sur Réessayer. Si le problème persiste, ne désinstalle pas l’application : la copie serait effacée avec elle."
          }
        }
      }
    },
    "storage.recovery.message.loadFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data couldn't be read. Nothing was deleted: try again, and if it keeps happening, restart the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture de tes données a échoué. Aucune donnée n'a été effacée : réessaie, et si ça continue, redémarre l'app."
          }
        }
      }
    },
    "storage.recovery.message.noCopy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app has not deleted anything: your data is still on this device. Tap Try again. If the problem persists, do not delete the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application n’a rien supprimé : tes données sont toujours sur cet appareil. Appuie sur Réessayer. Si le problème persiste, ne désinstalle pas l’application."
          }
        }
      }
    },
