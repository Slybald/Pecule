    "monthlyBudget.manualExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In manual mode, the total is a monthly plan including subscriptions and recorded purchases. Upcoming charges are not subtracted again. It does not prove payments have been made."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode manuel, le total est un plan mensuel incluant les abonnements et les achats saisis. Les échéances ne sont pas soustraites une seconde fois. Il ne prouve pas que les paiements ont été effectués."
          }
        }
