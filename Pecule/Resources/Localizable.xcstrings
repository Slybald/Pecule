  "strings" : {
    "\"%@\" has a projected 12-month cost of %@." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" has a projected 12-month cost of %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a un coût projeté sur 12 mois de %2$@."
          }
        }
      }
    },
    "\"%@\" has a projected 12-month cost of %@. Compare your actual need over a longer usage horizon." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" has a projected 12-month cost of %2$@. Compare your actual need over a longer usage horizon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a un coût projeté sur 12 mois de %2$@. Compare ton besoin réel sur un horizon d’usage plus long."
          }
        }
      }
    },
    "\"%@\" is a high-cost subscription. Consider reviewing or suspending it." : {
      "extractionState" : "stale",
