    "monthlyBudget.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly budget − net booked spending − remaining known charges. Booked spending is the bank transactions, plus the purchases you entered by hand that no transaction already represents (same amount, within 3 days). Received refunds reduce spending. Future discretionary spending is not estimated here. This margin is neither a bank balance nor guaranteed spending power. Goal reservations are explained separately in the living allowance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget du mois − dépenses nettes comptabilisées − échéances restantes connues. Les dépenses comptabilisées sont les opérations bancaires, plus les achats saisis à la main qu’aucune opération ne représente déjà (même montant, à 3 jours près). Les remboursements reçus réduisent les dépenses. Les dépenses spontanées futures ne sont pas estimées ici. Cette marge n’est pas un solde bancaire ni une capacité d’achat garantie. Les réservations d’objectifs sont expliquées séparément dans le reste à vivre."
          }
        }
      }
    },
    "monthlyBudget.form.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This euro budget applies only to the displayed month. It is independent of category limits and moves no money. Zero is a valid budget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce budget en euros concerne uniquement le mois affiché. Il reste indépendant des plafonds par catégorie et ne déplace aucun argent. Zéro est un budget valide."
          }
        }
      }
    },
